{
  "servers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${input:github_mcp_pat}"
      }
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "github_mcp_pat",
      "description": "GitHub Personal Access Token",
      "password": true
    }
  ],
  "info": {
    "name": "GitHub Copilot MCP Server",
    "version": "1.0.0",
    "description": "Model Context Protocol Server for GitHub integrations using FastAPI"
  },
  "repositories": [
    {
      "name": "langgraph",
      "full_name": "user/langgraph",
      "description": "LangGraph Agent workflow with MCP integration",
      "language": "Python",
      "stars": 42
    },
    {
      "name": "deepagents",
      "full_name": "user/deepagents",
      "description": "Autonomous deep subagent framework",
      "language": "Python",
      "stars": 128
    }
  ]
}